    { "type": "text", "id": "t_u1", "x": 405, "y": 88, "width": 210, "height": 144, "text": "U1\nESP32-S3-Kaluga-1\n────────────────\nGPIO21 (SDA) →\nGPIO22 (SCL) →\nGPIO2 (LED) →\n3.3V ←\nGND ←\n25/18/19/20 NC", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "left", "verticalAlign": "middle", "containerId": "u1", "originalText": "U1\nESP32-S3-Kaluga-1\n────────────────\nGPIO21 (SDA) →\nGPIO22 (SCL) →\nGPIO2 (LED) →\n3.3V ←\nGND ←\n25/18/19/20 NC", "autoResize": true },

