    { "type": "text", "id": "legend", "x": 820, "y": 350, "width": 340, "height": 120, "text": "Legend:\n─────────────\nRed = 3.3V Power\nBlue = I2C Bus\nOrange = GPIO Signal\nBlack = Signal/GND\nGreen = Sensor Section\nYellow = LED Indicator", "fontSize": 14, "fontFamily": 1, "strokeColor": "#495057", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Legend:\n─────────────\nRed = 3.3V Power\nBlue = I2C Bus\nOrange = GPIO Signal\nBlack = Signal/GND\nGreen = Sensor Section\nYellow = LED Indicator", "autoResize": true },

    { "type": "text", "id": "notes", "x": 40, "y": 500, "width": 1300, "height": 50, "text": "Operating Parameters: VCC 3.3V · I2C 400kHz · Sampling 100Hz · Window 128 samples · TCA9548A @0x70 (A0-A2→GND, EN→3.3V) · All GY-521 @0x68 via mux (AD0→GND) · Wire length <15cm · 0.1µF per IC + 10µF bulk · LRA GPIO25/18/19/20 deferred (NC)", "fontSize": 12, "fontFamily": 1, "strokeColor": "#868e96", "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Operating Parameters: VCC 3.3V · I2C 400kHz · Sampling 100Hz · Window 128 samples · TCA9548A @0x70 (A0-A2→GND, EN→3.3V) · All GY-521 @0x68 via mux (AD0→GND) · Wire length <15cm · 0.1µF per IC + 10µF bulk · LRA GPIO25/18/19/20 deferred (NC)", "autoResize": true }
