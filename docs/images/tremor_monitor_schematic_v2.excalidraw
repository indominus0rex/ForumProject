    {
      "type": "text",
      "id": "t_u1",
      "x": 455,
      "y": 118,
      "width": 230,
      "height": 164,
      "text": "U1\nESP32-S3-Kaluga-1 38-pin\n────────────────\nVIN ← (from MT3608)\n3V3 ← (onboard AMS1117)\nGND ← (ground)\nGPIO21 → I2C0 SDA\nGPIO22 → I2C0 SCL\nGPIO2  → LED",
      "fontSize": 16,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "u1",
      "originalText": "U1\nESP32-S3-Kaluga-1 38-pin\n────────────────\nVIN ← (from MT3608)\n3V3 ← (onboard AMS1117)\nGND ← (ground)\nGPIO21 → I2C0 SDA\nGPIO22 → I2C0 SCL\nGPIO2  → LED",
      "autoResize": true
    },
